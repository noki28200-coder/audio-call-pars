# ================================================================
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
# ================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=callsdb
POSTGRES_USER=callsuser
POSTGRES_PASSWORD=change_me_strong_password_here

# ── S3-хранилище записей (SeaweedFS) ──────────────────────────
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKET=call-audios

# ── API-ключ для аутентификации CRM и панели управления ──────
# На сайте ключ вводится в поле в шапке страницы.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_generate_secure_random_key

# ── MangoOffice API ───────────────────────────────────────────
# Получить в личном кабинете: Настройки → Интеграции → API
MANGO_API_KEY=your_mango_api_key_here
MANGO_API_SALT=your_mango_api_salt_here
MANGO_API_URL=https://app.mango-office.ru/vpbx

# Интервал опроса API (секунды, по умолчанию 5 минут)
POLL_INTERVAL_SECONDS=300
# Глубина поиска новых звонков (минуты)
LOOKBACK_MINUTES=10

# ── Повторы обработки ─────────────────────────────────────────
# Сколько раз повторять этап (скачивание, транскрибация, анализ) после ошибки
MAX_RETRIES=3

# ── Whisper (транскрибация) ───────────────────────────────────
# Размер модели: tiny | base | small | medium | large-v3
# CPU-ноут: medium (баланс). Медленная машина: small
WHISPER_MODEL=medium
WHISPER_LANGUAGE=ru
WHISPER_THREADS=4

# ── Ollama (ИИ-анализ звонков) ────────────────────────────────
# По умолчанию — Ollama, установленная на самой машине (https://ollama.com),
# модель скачивается заранее: ollama pull qwen3.5:9b  (~6.6 ГБ, нужно 16 ГБ RAM)
# Ollama в Docker: docker compose --profile docker-ollama up -d
#                  и OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# ── CRM / Фронтенд интеграция ────────────────────────────────
# Вебхук для отправки результатов анализа (оставь пустым если не нужно)
CRM_WEBHOOK_URL=

# ── Настройки для production ──────────────────────────────────
# Домен (для nginx, если нужен HTTPS в будущем)
# DOMAIN=calls.your-company.ru
